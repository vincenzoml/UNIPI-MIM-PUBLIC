
load base="maze.png"

let overlay(x) = rgb(
    mask(red(base),!x) + mask(constant(255),x),
    mask(green(base),!x),
    mask(blue(base),!x)
)

let isColor(img,rc,gc,bc) = (red(img) =. rc) & (green(img) =. gc) & (blue(img) =. bc)

let r = isColor(base,255,0,0)
let g = isColor(base,0,255,0)
let b = isColor(base,0,0,255)
let w = isColor(base,255,255,255)

let pathToExit = w T g


let f1 = pathToExit
save "1.png" overlay(f1)  







































let pathFromItem = w T b



let f2 = pathToExit & (!(pathFromItem))




let f3 = (!pathToExit) & (pathFromItem)



let f4 = w & (!pathToExit) & (!pathFromItem)



let f5 = b T pathToExit




save "2.png" overlay(f2)  
save "3.png" overlay(f3)
save "4.png" overlay(f4)
save "5.png" overlay(f5)
